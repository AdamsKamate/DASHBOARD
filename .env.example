# Environment variables
# .env must NEVER be committed (it is already in .gitignore).
# Fill this in so an external developer can run the project (C14).
#

# Database
# The 'db' host is the service name in docker-compose.yml
DATABASE_URL=postgresql://dashboard:dashboard@db:5432/dashboard

# Redis
REDIS_URL=redis://redis:6379

# Security
# Generate with: openssl rand -hex 32
JWT_SECRET=

# AES-256 key for encrypting OAuth tokens in the database (32 bytes in base64).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Public URLs
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8080

# Account confirmation email (C3)
# In development: MailHog in a container, or Mailtrap / Ethereal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@dashboard.local

# 
# SERVICES: see docs/Services.md for the complete list and team assignments
#

# 1. Weather (no authentication required)
# Open-Meteo does not require an API key.

# 2. RSS (no authentication required)

# 3. GitHub (OAuth 2.0)
# Create the application at: https://github.com/settings/developers
# Declare this authorization callback URL: http://localhost:8080/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/oauth/github/callback

# 4. Google (OAuth 2.0): Gmail + Calendar = one service
# Create the project at: https://console.cloud.google.com/apis/credentials
# Enable the Gmail and Google Calendar APIs, then create OAuth credentials.
# Authorized redirect URI: http://localhost:8080/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback
