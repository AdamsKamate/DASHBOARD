# Variables d'environnement
# .env ne doit JAMAIS être committé (déjà dans .gitignore).
# remplir pour qu'un développeur externe puisse lancer le projet (C14).
#

# Base de données 
# Le host 'db' est le nom du service dans docker-compose.yml
DATABASE_URL=postgresql://dashboard:dashboard@db:5432/dashboard

# Redis 
REDIS_URL=redis://redis:6379

# Sécurité
# Générer avec : openssl rand -hex 32
JWT_SECRET=

# Clé AES-256 pour chiffrer les tokens OAuth en base (32 octets en base64).
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY=

# URLs publiques
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8080

# Email de confirmation de compte (C3)
# En développement : MailHog en conteneur, ou Mailtrap / Ethereal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@dashboard.local

# 
# SERVICES : voir docs/services.md pour la liste complète et la répartition
# 

# 1. Weather (aucune authentification requise)
# Open-Meteo ne nécessite aucune clé API.

# 2. RSS (aucune authentification requise)

# 3. GitHub (OAuth 2.0)
# Créer l'application sur : https://github.com/settings/developers
# Authorization callback URL à déclarer : http://localhost:8080/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/oauth/github/callback

# 4. Google (OAuth 2.0) : Gmail + Calendar = un seul service
# Créer le projet sur : https://console.cloud.google.com/apis/credentials
# Activer les APIs Gmail et Google Calendar, puis créer des identifiants OAuth.
# URI de redirection autorisée : http://localhost:8080/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback
